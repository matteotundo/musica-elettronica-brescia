---
import '../styles/global.css';
import { etichette, gemella, collega, percorsoLogico, type Lingua } from '../lib/i18n';

interface Props {
  lingua: Lingua;
  titolo: string;
  descrizione?: string;
}

const { lingua, titolo, descrizione } = Astro.props;
const t = etichette[lingua];
const qui = percorsoLogico(Astro.url.pathname);
const altra = gemella[qui] ? collega(gemella[qui]) : undefined;
const anno = new Date().getFullYear();
---

<!doctype html>
<html lang={lingua}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titolo}</title>
    {descrizione && <meta name="description" content={descrizione} />}
    {altra && <link rel="alternate" hreflang={lingua === 'it' ? 'en' : 'it'} href={altra} />}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400&family=IBM+Plex+Sans:wght@400;500&family=IBM+Plex+Serif:wght@400&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <div class="guscio">
      <header class="testata">
        <a class="marchio" href={collega(lingua === 'it' ? '/' : '/en/')}>
          <strong style="letter-spacing: 0.01em">MUSICA ELETTRONICA per le arti intermediali</strong>
          <span>Conservatorio Luca Marenzio · Brescia</span>
        </a>
        <p class="lingue">
          <a href={lingua === 'it' ? collega(qui) : altra ?? collega('/')} aria-current={lingua === 'it'}
            >IT</a
          >/<a href={lingua === 'en' ? collega(qui) : altra ?? collega('/en/')} aria-current={lingua === 'en'}
            >EN</a
          >
        </p>
      </header>

      <nav class="nav">
        {
          t.nav.map((v) => (
            <a href={collega(v.href)} aria-current={qui === v.href ? 'page' : undefined}>
              {v.testo}
            </a>
          ))
        }
      </nav>

      <main>
        <slot />
      </main>

      <footer class="piede">
        <p>{t.sede}</p>
        <p>© {anno}</p>
      </footer>
    </div>
  </body>
</html>
